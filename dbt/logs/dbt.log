  create  table "nyc_taxi"."gold"."mart_revenue_by_zone__dbt_tmp"
  
  
    as
  
  (
    -- Mart model: mart_revenue_by_zone
-- Phân tích doanh thu và tiền tip theo khu vực đón khách

SELECT
    l.zone AS pickup_zone,
    l.borough AS pickup_borough,
    COUNT(*) AS total_trips,
    ROUND(SUM(t.total_amount)::NUMERIC, 2) AS total_revenue,
    ROUND(SUM(t.fare_amount)::NUMERIC, 2) AS total_fare,
    ROUND(SUM(t.tip_amount)::NUMERIC, 2) AS total_tips,
    ROUND(AVG(t.tip_percentage)::NUMERIC, 2) AS avg_tip_percentage
FROM "nyc_taxi"."gold"."fact_trips" t
JOIN "nyc_taxi"."gold"."dim_location" l ON t.pickup_location_id = l.location_id
GROUP BY 1, 2
ORDER BY total_revenue DESC
  );
  
[0m04:24:31.407500 [debug] [Thread-4 (]: SQL status: BEGIN in 0.090 seconds
[0m04:24:31.410291 [debug] [Thread-4 (]: Using postgres connection "model.nyc_taxi_platform.mart_monthly_trends"
[0m04:24:31.414416 [debug] [Thread-4 (]: On model.nyc_taxi_platform.mart_monthly_trends: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "nyc_taxi_profile", "target_name": "dev", "node_id": "model.nyc_taxi_platform.mart_monthly_trends"} */

  
    

  create  table "nyc_taxi"."gold"."mart_monthly_trends__dbt_tmp"
  
  
    as
  
  (
    -- Mart model: mart_monthly_trends
-- Month-over-month comparison 2024 vs 2025

SELECT
    dt.year,
    dt.month,
    COUNT(*)                             AS trip_count,
    ROUND(SUM(t.total_amount)::NUMERIC, 2) AS total_revenue,
    ROUND(AVG(t.trip_distance)::NUMERIC, 2) AS avg_distance
FROM "nyc_taxi"."gold"."fact_trips" t
JOIN "nyc_taxi"."gold"."dim_time" dt ON t.pickup_datetime = dt.datetime_id
GROUP BY dt.year, dt.month
ORDER BY dt.year, dt.month
  );
  
